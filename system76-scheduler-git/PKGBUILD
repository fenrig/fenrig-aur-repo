# Maintainer: Donald Carr <d _at_ chaos-reins.com>

_pkgname=system76-scheduler
pkgname=${_pkgname}-plasma-git
pkgver=ff744f2
pkgrel=1
epoch=2
pkgdesc='system76 userspace scheduler'
arch=(x86_64)
url='https://github.com/fenrig/system76-scheduler'
license=('MPL-2')
provides=(${_pkgname})
conflicts=(${_pkgname} system-scheduler-git)
depends=()
makedepends=(git rust just linux-headers pipewire rust-src)
_branch=dev_aya_bpf
source=("git+$url#branch=${_branch}")
sha256sums=('SKIP')
install=install.sh
backup=(
  'etc/system76-scheduler/assignments/default.ron'
)

pkgver() {
  cd ${_pkgname}
  git describe --tags --long --always | sed 's/^v//' | tr '-' '.'
}

build() {
  cd ${_pkgname}
  just build-release
}

package() {
  cd ${_pkgname}
  just sysconfdir=/usr/share rootdir=${pkgdir} install
}
