#!/bin/sh
set -eu
parser=/usr/bin/apparmor_parser
profiles=/etc/apparmor.d
failed=0

if [ ! -r /sys/kernel/security/apparmor/profiles ]; then
  printf '%s\n' 'fenrig-apparmor-profiles: AppArmor is not active; policy was not loaded.' >&2
  exit 0
fi

for profile in fenrig-clamav-native fenrig-clamav-quarantine-gui fenrig-clamav-scan-gui fenrig-clamav-scan-quarantine-helper fenrig-firefox fenrig-thunderbird \
  fenrig-libreoffice fenrig-evince fenrig-gwenview fenrig-okular fenrig-ark fenrig-spectacle \
  fenrig-chromium fenrig-chrome fenrig-wowup-cf fenrig-mumble fenrig-transmission-qt fenrig-mpv fenrig-lutris fenrig-electron fenrig-discord \
  fenrig-steam fenrig-wine; do
  printf 'fenrig-apparmor-profiles: replacing %s\n' "$profile" >&2
  if ! "$parser" --replace "$profiles/$profile"; then
    printf 'fenrig-apparmor-profiles: FAILED to replace %s\n' "$profile" >&2
    failed=1
  fi
done
if [ "$failed" -ne 0 ]; then
  printf '%s\n' 'fenrig-apparmor-profiles: one or more policies failed to load; existing kernel policy was not unloaded.' >&2
  exit 1
fi
printf '%s\n' 'fenrig-apparmor-profiles: all policies loaded/replaced successfully.' >&2
