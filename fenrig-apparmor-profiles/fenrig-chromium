# vim:syntax=apparmor
abi <abi/4.0>,
include <tunables/global>

# Replaces Arch's unconfined profile named chromium without overwriting its
# package-owned /etc/apparmor.d/chromium file.
profile chromium /usr/lib/chromium/chromium {
  include <abstractions/fenrig-chromium-common>
  /usr/lib/chromium/** ixr,
  /usr/lib/thunderbird/thunderbird Px -> thunderbird,
  owner @{HOME}/.config/chromium/** rwk,
  owner @{HOME}/.cache/chromium/ rw,
  owner @{HOME}/.cache/chromium/** rwk,
  owner @{HOME}/.pki/ r,
  owner @{HOME}/.pki/nssdb/ rw,
  owner @{HOME}/.pki/nssdb/** rwk,
  owner @{HOME}/.local/share/chromium/** rwk,
  include if exists <local/fenrig-chromium>
}
