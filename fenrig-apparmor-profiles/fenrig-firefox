# vim:syntax=apparmor
abi <abi/4.0>,
include <tunables/global>

# Matches the apparmor package's unconfined profile name. The package-owned
# file is loaded with --replace; /etc/apparmor.d/firefox is never overwritten.
profile firefox /usr/lib/firefox/firefox {
  include <abstractions/fenrig-browser-common>
  /usr/lib/firefox/firefox rix,
  /usr/lib/firefox/ r,
  /usr/lib/firefox/{crashhelper,gfxtest,plugin-container} rix,
  /usr/lib/firefox/crashreporter rix,
  /usr/lib/firefox/** mrix,
  deny /usr/lib/firefox/** w,
  /usr/lib/thunderbird/thunderbird Px -> thunderbird,
  /usr/lib/firefoxpwa/firefoxpwa-connector rix,
  /usr/libexec/clamav/clamav-thunderbird-host rPx -> fenrig-clamav-native,
  include if exists <local/fenrig-firefox>
}
