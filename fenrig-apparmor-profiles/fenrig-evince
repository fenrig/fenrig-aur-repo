# vim:syntax=apparmor
abi <abi/4.0>,
include <tunables/global>

# Evince is optional on the target fleet; this exact attachment is included
# for systems that install /usr/bin/evince.
profile evince /usr/bin/evince {
  include <abstractions/fenrig-document-common>
  /usr/bin/evince mr,
  /usr/lib/firefox/firefox Px -> firefox,
  /usr/lib/chromium/chromium Px -> chromium,
  /opt/google/chrome/chrome Px -> chrome,
  /usr/bin/cromite Px -> cromite,
  /usr/lib/thunderbird/thunderbird Px -> thunderbird,
  /usr/bin/gwenview Px -> gwenview,
  /usr/bin/libreoffice Px -> libreoffice,
  /usr/lib/libreoffice/program/soffice.bin Px -> libreoffice,
  owner @{HOME}/.config/evince/** rwk,
  owner @{HOME}/.cache/evince/** rwk,
  include if exists <local/fenrig-evince>
}
