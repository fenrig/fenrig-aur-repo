# vim:syntax=apparmor
abi <abi/4.0>,

# Read-only runtime introspection needed by modern desktop applications and
# their sandboxes. The PROC rule is owner-scoped; cgroup and kernel metadata
# are non-secret system state and are read-only.
owner @{PROC}/@{pid}/** r,
owner @{PROC}/@{pid}/task/**/comm w,
owner @{PROC}/@{pid}/{uid_map,gid_map,setgroups} rw,
owner @{PROC}/@{pid}/coredump_filter w,
/proc/net/if_inet6 r,
/proc/*/net/if_inet6 r,
/proc/pressure/ r,
/proc/pressure/** r,
/proc/version r,
/proc/sys/vm/mmap_min_addr r,
/sys/fs/cgroup/**/{cpu.max,memory.max,memory.high,memory.low} r,
/sys/fs/cgroup/cgroup.controllers r,
/sys/kernel/mm/hugepages/ r,
/sys/kernel/mm/hugepages/** r,
/sys/kernel/mm/transparent_hugepage/ r,
/sys/kernel/mm/transparent_hugepage/** r,
/dev/ r,
/ r,
/etc/fstab r,
/etc/paperspecs r,
/sys/{bus,class}/ r,
/sys/{bus,class}/** r,
/run/udev/data/** r,
/opt/cuda/ mr,
/opt/cuda/** mr,
/etc/java-openjdk/security/java.security r,
/usr/bin/gpgconf rix,
/usr/bin/gpg rix,
/usr/bin/gpgsm rix,
/usr/bin/ldd rix,
/usr/bin/ r,
/{usr/,}lib/ld-linux*.so.* rix,
/usr/lib/kf6/kioworker rix,
/usr/bin/{testparm,net} rix,
owner @{HOME}/ r,
owner @{HOME}/** r,
owner @{HOME}/.config/ rw,
owner @{HOME}/.config/QtProject.conf rwk,
owner @{HOME}/.config/kdeglobals.* rwl,
owner @{HOME}/.config/#* rwkl,
owner /run/user/*/*.kioworker.socket l,
owner /run/user/*/*kioworker.socket rwkl,
owner /run/user/*/#* rwkl,
/var/cache/fontconfig/ rw,
/var/cache/fontconfig/** rwk,

include if exists <local/fenrig-runtime-common>
