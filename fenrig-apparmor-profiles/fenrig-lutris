# vim:syntax=apparmor
abi <abi/4.0>,
include <tunables/global>

profile lutris /usr/bin/lutris {
  ptrace (read) peer=unconfined,
  include <abstractions/fenrig-removable-common>
  include <abstractions/fenrig-kde-state-common>
  include <abstractions/fenrig-gpu-common>
  include <abstractions/fenrig-gpu-wrappers-common>
  include <abstractions/fenrig-game-input-common>
  include <abstractions/fenrig-tablet-common>
  include <abstractions/fenrig-sandbox-common>
  include <abstractions/base>
  include <abstractions/audio>
  include <abstractions/video>
  include <abstractions/wayland>
  include <abstractions/fonts>
  include <abstractions/mesa>
  include <abstractions/vulkan>
  include <abstractions/nameservice>
  include <abstractions/openssl>
  include <abstractions/p11-kit>
  include <abstractions/dbus-session-strict>
  include <abstractions/dconf>
  include <abstractions/kde>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  /etc/{,ssl/} r,
  /etc/{hosts,resolv.conf,nsswitch.conf,localtime,timezone,mime.types} r,
  # Lutris helpers use findmnt/libmount to discover filesystem mounts.
  /etc/{fstab,mtab} r,
  /etc/ld.so.cache r,
  /etc/ssl/certs/** r,
  / r,
  /proc/ r,
  /proc/** r,
  /run/mount/ r,
  /run/mount/** r,
  @{sys}/devices/system/node/ r,
  @{sys}/devices/system/node/** r,
  /sys/class/drm/ r,
  /sys/class/drm/** r,
  /proc/driver/nvidia/version r,
  /usr/ r,
  /usr/** r,
  /usr/bin/ r,
  /usr/lib/ r,
  /usr/bin/lutris rix,
  /usr/bin/python* rix,
  # Lutris launchers and runners may invoke arbitrary system commands.
  /usr/bin/** ix,
  /usr/sbin/** ix,
  /usr/bin/{findmnt,pgrep,gcc,ld,ldconfig,glxinfo,uname,vulkaninfo,lspci,xrandr,gtk-update-icon-cache,gtk4-update-icon-cache,flatpak,gamemoderun} ix,
  /usr/bin/bash rix,
  /usr/bin/env ix,
  /usr/bin/wine rix,
  /usr/bin/wineserver rix,
  /usr/lib/wine/** ixr,
  /usr/share/lutris/** r,
  /usr/share/lutris/bin/lutris-wrapper rix,
  /usr/lib/python*/** r,
  /usr/lib/** mr,
  /usr/lib/glycin-loaders/** rix,
  /usr/share/{,**} r,
  /usr/share/fonts/** r,
  /usr/share/icons/** r,
  /var/lib/flatpak/ r,
  /var/lib/flatpak/** r,

  userns,
  capability sys_admin,
  capability sys_chroot,
  capability net_admin,
  owner @{PROC}/@{pid}/** r,
  owner @{PROC}/@{pid}/oom_score_adj w,
  owner /{dev,run,var/run}/shm/** rwk,
  owner /tmp/** rwk,
  owner /var/tmp/** rwk,

# Lutris is intentionally broad: game launchers and Windows runtimes may use
# arbitrary user-owned prefixes, launchers, caches, and helper files anywhere
# in HOME. The explicit private-data denies below remain authoritative.
owner @{HOME}/ rw,
# Keep broad data access for launchers and prefixes, but do not make every
# user-owned file executable. Execution remains explicit for game libraries,
# Wine prefixes, Downloads, and the helper programs below.
owner @{HOME}/** rwk,

  owner @{HOME}/.config/lutris/** rwk,
  owner @{HOME}/.local/share/lutris/** rwkix,
  owner @{HOME}/.cache/lutris/ rw,
  owner @{HOME}/.cache/lutris/** rwk,
  owner @{HOME}/Games/** rwkix,
  owner @{HOME}/.wine/** rwkix,
  owner @{HOME}/.local/share/wineprefixes/** rwkix,
  owner @{HOME}/.local/share/Steam/** rwkix,
  owner @{HOME}/.steam/** rwkix,
  owner @{HOME}/Downloads/** rwkix,
  owner @{HOME}/Desktop/** rwkix,
  owner @{HOME}/Public/** rwkix,
  owner @{HOME}/.config/gtk-3.0/bookmarks r,
  owner @{HOME}/.local/share/applications/mimeapps.list r,
  owner @{HOME}/.local/share/applications/mimeinfo.cache r,

  deny @{HOME}/.ssh/** r,
  deny @{HOME}/.gnupg/** r,
  deny @{HOME}/.aws/** r,
  deny @{HOME}/.kube/** r,
  deny @{HOME}/.password-store/** r,
  deny @{HOME}/.local/share/keyrings/** r,
  deny @{HOME}/.local/share/gnome-keyring/** r,
  deny @{HOME}/.config/kwalletd/** r,
  deny @{HOME}/.config/kwalletrc r,
  deny @{HOME}/.config/mozilla/** r,
  deny @{HOME}/.thunderbird/** r,
  deny @{HOME}/.config/google-chrome/** r,
  deny @{HOME}/.config/chromium/** r,
  deny @{HOME}/.config/discord/** r,
  deny @{HOME}/.config/1Password/** r,
  deny @{HOME}/.config/keepassxc/** r,
  deny @{HOME}/**/*.pem r,
  deny @{HOME}/**/*.key r,
  deny @{HOME}/.bashrc rw,
  deny @{HOME}/.profile rw,
  deny @{HOME}/.bash_profile rw,
  deny @{HOME}/.zshrc rw,
  deny @{HOME}/.config/fish/** r,
  deny @{HOME}/.config/zsh/** r,
  deny @{HOME}/.xonshrc r,
  deny @{HOME}/.xonshrc w,
  include if exists <local/fenrig-lutris>
}
