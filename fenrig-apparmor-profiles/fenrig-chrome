# vim:syntax=apparmor
abi <abi/4.0>,
include <tunables/global>

# Replaces Arch's unconfined profile named chrome without overwriting its
# package-owned /etc/apparmor.d/chrome file.
profile chrome /opt/google/chrome/chrome {
  include <abstractions/fenrig-chromium-common>
  /opt/google/chrome/** ixr,
  /usr/lib/thunderbird/thunderbird Px -> thunderbird,
  owner @{HOME}/.config/google-chrome/** rwk,
  owner @{HOME}/.cache/google-chrome/ rw,
  owner @{HOME}/.cache/google-chrome/** rwk,
  owner @{HOME}/.pki/ r,
  owner @{HOME}/.pki/nssdb/ rw,
  owner @{HOME}/.pki/nssdb/** rwk,
  owner @{HOME}/.local/share/google-chrome/** rwk,
  include if exists <local/fenrig-chrome>
}
