# vim:syntax=apparmor
abi <abi/4.0>,
include <tunables/global>

profile thunderbird /usr/lib/thunderbird/thunderbird flags=(attach_disconnected) {
  include <abstractions/fenrig-browser-common>
  /usr/lib/thunderbird/thunderbird rix,
  owner @{HOME}/.thunderbird/ rw,
  owner @{HOME}/.thunderbird/** rwk,
  owner @{HOME}/.config/thunderbird/ rw,
  owner @{HOME}/.config/thunderbird/** rwk,
  owner @{HOME}/.cache/thunderbird/ rw,
  owner @{HOME}/.cache/thunderbird/** rwk,
  /usr/lib/thunderbird/{crashhelper,gfxtest,plugin-container} rix,
  /usr/lib/thunderbird/ r,
  /usr/lib/thunderbird/** mrix,
  deny /usr/lib/thunderbird/** w,
  /usr/libexec/clamav/clamav-thunderbird-host rPx -> fenrig-clamav-native,
  include if exists <local/fenrig-thunderbird>
}
