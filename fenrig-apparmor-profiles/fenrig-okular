# vim:syntax=apparmor
abi <abi/4.0>,
include <tunables/global>

profile okular /usr/bin/okular {
  include <abstractions/fenrig-document-common>
  /usr/bin/okular mr,
  /usr/lib/firefox/firefox Px -> firefox,
  /usr/lib/chromium/chromium Px -> chromium,
  /opt/google/chrome/chrome Px -> chrome,
  /usr/bin/cromite Px -> cromite,
  /usr/lib/thunderbird/thunderbird Px -> thunderbird,
  /usr/lib/qt6/plugins/** mr,
  owner @{HOME}/.config/okularpartrc.* rwl,
  owner @{HOME}/.config/okularpartrc rwk,
  owner @{HOME}/.config/okularrc.lock rwk,
  owner @{HOME}/.config/okularrc rwk,
  owner @{HOME}/.config/okularrc.?????? rw,
  owner link subset @{HOME}/.config/okularrc.?????? -> "@{HOME}/.config/#[0-9]*",
  owner @{HOME}/.local/share/okular/** rwk,
  owner @{HOME}/.local/state/okularstaterc rwk,
  owner @{HOME}/.local/state/okularstaterc.?????? rw,
  owner link subset @{HOME}/.local/state/okularstaterc.?????? -> "@{HOME}/.local/state/#[0-9]*",
  owner @{HOME}/.cache/okular/** rwk,
  include if exists <local/fenrig-okular>
}
