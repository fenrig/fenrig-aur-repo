# vim:syntax=apparmor
abi <abi/4.0>,
include <tunables/global>

# Bubblewrap needs a separate setup domain. Keeping this profile unattached
# avoids competing with Flatpak or another package that owns /usr/bin/bwrap;
# fenrig-sandbox-common enters it explicitly from the confined application.
# The broad setup permissions are limited to bwrap itself. Its children are
# stacked with fenrig-bwrap-unpriv so they do not retain the setup domain's
# capabilities.
profile fenrig-bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow dbus,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,

  # bwrap uses no_new_privs while constructing the sandbox. Stack its
  # children against the capability-stripped profile below.
  allow pix /** -> &fenrig-bwrap//&fenrig-bwrap-unpriv,

  include if exists <local/fenrig-bwrap>
}

# Strip capabilities from processes after bwrap has completed namespace setup.
profile fenrig-bwrap-unpriv flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow dbus,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow pix /** -> &fenrig-bwrap-unpriv,
  audit deny capability,

  include if exists <local/fenrig-bwrap-unpriv>
}
