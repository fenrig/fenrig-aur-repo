check() {
  local checkdir profile
  local profiles=(
    fenrig-bwrap fenrig-firefox fenrig-thunderbird fenrig-libreoffice
    fenrig-evince fenrig-gwenview fenrig-okular fenrig-ark fenrig-spectacle
    fenrig-chromium fenrig-chrome fenrig-cromite fenrig-wowup-cf fenrig-mumble
    fenrig-transmission-qt fenrig-mpv fenrig-mpv-yt-dlp fenrig-lutris fenrig-electron fenrig-discord
    fenrig-steam fenrig-wine fenrig-clamav-native fenrig-clamav-quarantine-gui
    fenrig-clamav-scan-gui fenrig-clamav-scan-quarantine-helper
  )
  local abstractions=(
    fenrig-browser-common fenrig-sandbox-common fenrig-runtime-common
    fenrig-removable-common fenrig-kde-state-common fenrig-plasma-browser-common
    fenrig-document-common fenrig-electron-common fenrig-chromium-common
    fenrig-compat-common fenrig-gpu-common fenrig-gpu-wrappers-common
    fenrig-game-input-common fenrig-eid-common fenrig-tablet-common
  )

  checkdir=$(mktemp -d)
  trap 'rm -rf -- "$checkdir"' EXIT
  mkdir -p "$checkdir/abstractions" "$checkdir/local"

  for profile in "${abstractions[@]}"; do
    install -Dm644 "$srcdir/$profile" "$checkdir/abstractions/$profile"
  done

  for profile in "${profiles[@]}"; do
    install -Dm644 "$srcdir/$profile" "$checkdir/$profile"
  done

  for profile in "${profiles[@]}"; do
    printf 'Checking AppArmor profile %s\n' "$profile"
    apparmor_parser --skip-kernel-load --skip-read-cache --abort-on-error \
      -I "$checkdir" -I /etc/apparmor.d -Q "$checkdir/$profile"
  done
}

