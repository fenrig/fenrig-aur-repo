# Maintainer: Fenrig
pkgname=fenrig-apparmor-profiles
pkgver=0.1.0
pkgrel=108
pkgdesc='Restrictive AppArmor policies for common Plasma desktop applications'
arch=('any')
url='https://github.com/fenrig/fenrig-aur-repo'
license=('MIT')
depends=('apparmor')
optdepends=(
  'firefox: browser executable covered by the Firefox policy'
  'thunderbird: mail client executable covered by the Thunderbird policy'
  'eid-mw: Belgian eID PKCS#11 middleware for Firefox/Thunderbird smart cards'
  'pcsclite: PC/SC daemon used by the Belgian eID middleware'
  'clamav-lazy: ClamAV native-messaging scanner integration'
  'libreoffice-fresh: office executable covered by the LibreOffice policy'
  'evince: optional PDF viewer executable covered by the Evince policy'
  'gwenview: image viewer executable covered by the Gwenview policy'
  'okular: document viewer executable covered by the Okular policy'
  'ark: archive manager executable covered by the Ark policy'
  'spectacle: screenshot application executable covered by the Spectacle policy'
  'chromium: Chromium executable covered by the Chromium policy'
  'google-chrome: Google Chrome executable covered by the Chrome policy'
  'cromite-bin: Cromite executable covered by the Cromite policy'
  'wowup-cf-bin: WoWUp-CF executable covered by the WoWUp policy'
  'mumble: Mumble executable covered by the Mumble policy'
  'transmission-qt: optional Qt torrent client executable covered by the Transmission policy'
  'mpv: mpv media player executable covered by the mpv policy'
  'yt-dlp: YouTube and other video-site extraction helper used by mpv'
  'lutris: broad Lutris game launcher and runtime policy'
  'electron: optional system Electron runtime policy; applies to all apps using that runtime'
  'discord: optional Discord executable policy'
  'steam: broad compatibility profile for the Steam client and Proton games'
  'wine-staging: broad compatibility profile for Wine applications'
)
checkdepends=('apparmor')
install='fenrig-apparmor-profiles.install'
source=(
