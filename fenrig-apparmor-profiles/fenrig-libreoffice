# vim:syntax=apparmor
abi <abi/4.0>,
include <tunables/global>

profile libreoffice /usr/lib/libreoffice/program/soffice.bin {
  include <abstractions/fenrig-document-common>
  /etc/libreoffice/ r,
  /etc/libreoffice/** r,
  /etc/libreoffice/{bootstraprc,psprint.conf,sofficerc} r,
  /usr/bin/{bash,gpg,gpgconf,gpgsm,paperconf} rix,
  /usr/lib/firefox/firefox Px -> firefox,
  /usr/lib/chromium/chromium Px -> chromium,
  /opt/google/chrome/chrome Px -> chrome,
  /usr/bin/cromite Px -> cromite,
  /usr/lib/thunderbird/thunderbird Px -> thunderbird,
  /usr/bin/gwenview Px -> gwenview,
  /usr/bin/okular Px -> okular,
  /usr/bin/evince Px -> evince,
  owner @{HOME}/.thunderbird/profiles.ini r,
  owner @{HOME}/.thunderbird/{cert9.db,pkcs11.txt} rwk,
  owner @{HOME}/.thunderbird/**/{cert9.db,pkcs11.txt} rwk,
  owner @{HOME}/.thunderbird/**/key4.db rwk,
  owner @{HOME}/.mozilla/firefox/profiles.ini r,
  owner @{HOME}/{Templates,Sjablonen}/ r,
  owner @{HOME}/{Templates,Sjablonen}/** r,
  /usr/lib/libreoffice/ r,
  /usr/lib/libreoffice/** mrix,
  deny /usr/lib/libreoffice/** w,
  owner @{HOME}/.config/libreoffice/** rwk,
  owner @{HOME}/.cache/libreoffice/** rwk,
  owner @{HOME}/.config/qt6ct/qt6ct.conf r,
  owner @{HOME}/Documents/** rwk,
  owner @{HOME}/Downloads/** rwk,
  owner @{HOME}/Desktop/** rwk,
  include if exists <local/fenrig-libreoffice>
}
