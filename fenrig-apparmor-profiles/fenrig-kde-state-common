# vim:syntax=apparmor
abi <abi/4.0>,

# KDE applications use this directory for atomic configuration updates and
# shared KIO settings. Directory rw does not grant read/write access to every
# file below it; application-specific data rules remain explicit.
owner @{HOME}/.config/ rw,
owner @{HOME}/.config/kioslaverc rwk,
owner @{HOME}/.config/kwalletrc r,
owner @{HOME}/.config/#* rwk,
owner @{HOME}/.config/*.lock rwk,
owner @{HOME}/.local/state/ rw,
owner @{HOME}/.local/state/#* rwk,
owner @{HOME}/.local/state/*.lock rwk,
owner @{HOME}/.local/share/ rw,
owner @{HOME}/.local/share/#* rwk,
owner @{HOME}/.local/share/*.lock rwk,
